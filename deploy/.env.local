# ==============================================================================
# MRPL SOVEREIGN ON-PREMISE AI WORKBENCH - LOCAL ENVIRONMENT CONFIGURATION
# ==============================================================================

# Sovereignty & Security
DEPLOYMENT_MODE=LOCAL_AIR_GAPPED
AIR_GAPPED_MODE=true
REQUIRE_INTERNET=false
DATA_LEAKAGE_FIREWALL_STRICT=true

# Local Services & Endpoints (All 100% Localhost / Internal)
LOCAL_BACKEND_PORT=8000
LOCAL_FRONTEND_PORT=5173
LOCAL_MODEL_ENDPOINT=http://localhost:11434
LOCAL_VECTOR_DB_URL=http://localhost:6333

# Storage Paths
UPLOAD_DIR=./data/uploads
EXTRACTED_PAGES_DIR=./data/extracted_pages
LOG_DIR=./logs

# Explicit Prohibition: No Cloud API Keys Required
OPENAI_API_KEY=""
GOOGLE_API_KEY=""
ANTHROPIC_API_KEY=""
